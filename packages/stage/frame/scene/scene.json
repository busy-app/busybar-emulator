  },
  {
   "id": "led_right",
   "kind": "color",
   "default": {
    "r": 0,
    "g": 0,
    "b": 0,
    "a": 1
   },
   "meaning": "colour of the RGB LED strip right of Start (the wheel side), as led_left",
   "readByStage": true
  },
  {
   "id": "led_right_level",
   "kind": "number",
   "default": 0,
   "meaning": "0..1, how bright the right strip glows, as led_left_level",
   "readByStage": true
